\section{Effect of Anchor Set Size $m$}
\label{app:ablation_m}
We fix $D=512$ and vary the anchor size $m$ from $51$ to $2048$ on CartPole. Theorem~\ref{thm:fed_gap_main} predicts a regime change around $m=D$: when $m < D$, the anchor feature matrix is rank-deficient, Term~(II) is unbounded, and compiled weights generalize poorly. Once $m \geq D$, the residual reduces to the heterogeneity floor $\mathcal{O}(D^{-1/2})$.

Figure~\ref{fig:ablation2} shows the phase transition: the compiled error in the middle panel drops steeply within the under-determined regime; once $m\ge D$, the error stabilizes near the geometry floor, and FedQHD performance becomes reliable. The learning curve and policy value are unstable when $m < D$, but converge reliably to $V\approx500$ once $m \geq D$, reflecting the boundary sensitivity of the ridge solve.

Together with the ablation on dimension, this confirms the design rule $m \geq D$: the encoder dimension sets the geometry floor ($D^{-1/2}$ scaling), and the anchor count determines the projection regime, both predicted by Theorem~\ref{thm:fed_gap_main}.

\begin{figure*}[t]
  \centering
  \includegraphics[width=\textwidth]{figures/ablation2_vary_m.pdf}
  \caption{
           Ablation 2 (vary $m$, fix $D=512$): learning curves (left), Q-error vs.\ $m/D$ with the $m=D$ transition (middle), and final policy value (right).}
  \label{fig:ablation2}
\end{figure*}





\section{Scalability Analysis}
\label{subsec:scalability}
We evaluate the scalability of FedQHD by varying $N \in \{1, 2, 5, 20\}$ on CartPole and LunarLander, measuring the average reward over the final 30 episodes after 500 episodes. Following standard benchmarks, we define a task as \emph{solved} when the rolling average reward $\geq\!475$ for CartPole and $\geq\!200$ for LunarLander. The dashed red line in each panel marks this threshold; bars that cross it indicate a qualitatively reliable policy.

Figure~\ref{fig:scalability} shows the consistently improved final reward of FedQHD with $N$, yielding gains of $+30.6\%$ on CartPole and $+29.5\%$ on LunarLander relative to $N=1$ with no degradation at large $N$, which demonstrates that federation is a reliable lever for performance in FedQHD. Notably, a modest $N\!=\!5$ already recovers most of the scalability benefit on both environments, suggesting that FedQHD is well-suited to practical deployments where large client counts are often infeasible.

\begin{figure*}[t]
    \centering
    \includegraphics[width=0.75\textwidth]{figures/scalability_bar_combined.pdf}
    \caption{FedQHD performance at 575--600 episodes vs.\ number of clients $N$.}
    \label{fig:scalability}
\end{figure*}

Across homogeneous and heterogeneous settings, FedQHD consistently matches or exceeds federated DQN baselines while requiring substantially less computation. Its performance degradation under encoder mismatch follows the projection regime predicted by Theorem~\ref{thm:fed_gap_main}, and its scalability saturates once the dominant value subspace is sufficiently covered. Together, the results validate the geometric design principles underlying FedQHD.

\section{Proof of Theorem~\ref{thm:invisibility}}
\label{app:proof_invisibility}
\begin{proof}
By the Woodbury identity applied to
\[
W^{\mathrm{glob}}_i = \left(X_i^\mathrm{H} X_i + \lambda I_{D_i}\right)^{-1} X_i^\mathrm{H} Q^{\mathrm{glob}}_{\mathrm{ref}},
\]
the compiled Q-function evaluates as:
\begin{equation}
    Q_i(s,a;\,W^{\mathrm{glob}}_i)
    = \mathbf{k}_i(s)^{\!\top}
       (G_i+\lambda I_m)^{-1}
       Q^{\mathrm{glob}}_{\mathrm{ref},a}.
\end{equation}
Decompose the teacher:
$Q^{\mathrm{glob}}_{\mathrm{ref},a}
= P_i\,Q^{\mathrm{glob}}_{\mathrm{ref},a} + R_{i,0,a}$,
where
$P_i\,Q^{\mathrm{glob}}_{\mathrm{ref},a} \in \mathrm{col}(X_i)$
and $R_{i,0,a} \in \mathrm{col}(X_i)^{\perp} = \ker(G_i)$.
Since $(G_i + \lambda I_m)^{-1}$ preserves the eigenspaces of $G_i$,
the vector $(G_i+\lambda I_m)^{-1}R_{i,0,a}$ remains in $\ker(G_i)$,
which is orthogonal to
$\mathbf{k}_i(s) \in \mathrm{col}(X_i)$.
Hence $\mathbf{k}_i(s)^{\top}(G_i + \lambda I)^{-1} R_{i,0,a} = 0$.
\end{proof}

\section{Proof of Lemma~\ref{lem:term_A}: Encoder Heterogeneity Bias}
\label{app:proof_termA}

We bound the deviation between a client oracle
$\hat Q_i$ and the federation average
$\bar Q = \sum_j \pi_j \hat Q_j$.

\begin{proof}

Recall $\hat Q_k(\cdot,a)=\Pi_kQ^*(\cdot,a)$. Fix an action $a$ and suppress it from the notation.

First, the triangle inequality through $Q^*$ gives
\begin{equation}
\|\hat Q_i-\hat Q_j\|_{\mathcal H}
\le \|(I-\Pi_i)Q^*\|_{\mathcal H}
+\|(I-\Pi_j)Q^*\|_{\mathcal H}
\le \varepsilon_i^{\mathrm{rep}}+\varepsilon_j^{\mathrm{rep}}.
\label{eq:triangle_main}
\end{equation}
Second, since $\hat Q_i-\hat Q_j=(\Pi_i-\Pi_j)Q^*$,
\[
\|\hat Q_i-\hat Q_j\|_{\mathcal H}
\le \|\Pi_i-\Pi_j\|_{\mathcal H\to\mathcal H}\|Q^*\|_{\mathcal H}
\le B\sin\theta_{ij}.
\]
Combining the two routes,
\begin{equation}
\|\hat Q_i-\hat Q_j\|_{\mathcal H}
\le h_{ij}
=\min\{B\sin\theta_{ij},\varepsilon_i^{\mathrm{rep}}+\varepsilon_j^{\mathrm{rep}}\}.
\label{eq:pairwise_clean}
\end{equation}
Moreover,
\[
\hat Q_i-\bar Q
=\sum_{j\ne i}\pi_j(\hat Q_i-\hat Q_j),
\]
so the triangle inequality yields
\begin{equation}
\|\hat Q_i-\bar Q\|_{\mathcal H}
\le\sum_{j\ne i}\pi_jh_{ij}
=\bar h_i.
\label{eq:termA_H_final}
\end{equation}
Finally, the reproducing property and $\kappa(s,s)\le1$ imply
\[
|\hat Q_i(s,a)-\bar Q(s,a)|
\le\|\hat Q_i-\bar Q\|_{\mathcal H}
\le\bar h_i,
\]
as claimed.
\end{proof}

\section{Proof of Theorem~\ref{thm:fed_gap_main}}
\label{app:proof_termB}
Let
\[
P_i\defeq X_iX_i^\dagger,\qquad
P_{\mathrm{row}}\defeq X_i^\dagger X_i,\qquad
\mathcal R_i(Y)\defeq(X_i^{\mathrm H}X_i+\lambda I)^{-1}X_i^{\mathrm H}Y.
\]
Algorithm~\ref{alg:fedqhd_heterogeneous} compiles
$Q_{\mathrm{ref}}^{\mathrm{glob}}=\sum_j\pi_jQ_j^{\mathrm{ref}}$ from the learned client predictors. Introduce the oracle-mean labels
$\bar Q^{\mathrm{ref}}\defeq\sum_j\pi_j\hat Q_j^{\mathrm{ref}}$ and the intermediate weights
\[
\hat W_i^{\mathrm{ridge}}\defeq\mathcal R_i(\hat Q_i^{\mathrm{ref}}),
\qquad
\bar W_i^{\mathrm{ridge}}\defeq\mathcal R_i(\bar Q^{\mathrm{ref}}),
\qquad
W_i^{\mathrm{glob}}=\mathcal R_i(Q_{\mathrm{ref}}^{\mathrm{glob}}).
\]
A direct triangle inequality gives
\begin{equation}
|\Delta_i(s,a)|
\le
\underbrace{|\hat Q_i(s,a)-Q_i(s,a;\hat W_i^{\mathrm{ridge}})|}_{B_1}
+
\underbrace{|Q_i(s,a;\hat W_i^{\mathrm{ridge}})-Q_i(s,a;\bar W_i^{\mathrm{ridge}})|}_{B_2}
+
\underbrace{|Q_i(s,a;\bar W_i^{\mathrm{ridge}})-Q_i(s,a;W_i^{\mathrm{glob}})|}_{B_3}.
\label{eq:master_decomp}
\end{equation}
Thus heterogeneity enters only through the oracle-label change in $B_2$; there is no additional pointwise copy of Lemma~\ref{lem:term_A}.

\subsection*{Step 1: Bound $B_1$ (ridge shrinkage and anchor coverage)}
Since
\[
I-(X_i^{\mathrm H}X_i+\lambda I)^{-1}X_i^{\mathrm H}X_i
=\lambda(X_i^{\mathrm H}X_i+\lambda I)^{-1},
\]
decompose $\hat W_{i,a}=P_{\mathrm{row}}\hat W_{i,a}+(I-P_{\mathrm{row}})\hat W_{i,a}$. On $\mathrm{row}(X_i)$, the operator norm of
$\lambda(X_i^{\mathrm H}X_i+\lambda I)^{-1}$ is at most
$\lambda/(\gamma_i+\lambda)$; on $\ker(X_i)$ it is one. Therefore
\[
B_1
\le
\left(\frac{\lambda}{\gamma_i+\lambda}+\rho_i(s)\right)\|\hat W_i\|_F,
\qquad
\rho_i(s)=\|(I-P_{\mathrm{row}})\Phi_i(s)\|_2.
\]
Moreover,
\[
\|P_{\mathrm{row}}\Phi_i(s)\|_2^2
=\mathbf k_i(s)^{\mathrm H}G_i^\dagger\mathbf k_i(s),
\]
which gives the expression for $\rho_i(s)$ in Theorem~\ref{thm:fed_gap_main}. This term vanishes when $X_i$ has full column rank.

\subsection*{Step 2: Sensitivity to anchor labels}
For label matrices $Y,Y'$ and $v_a=Y_a-Y'_a$, linearity of ridge and the representer identity give
\[
|Q_i(s,a;\mathcal R_i(Y))-Q_i(s,a;\mathcal R_i(Y'))|
\le
\left|\mathbf k_i(s)^{\mathrm H}(G_i+\lambda I)^{-1}P_iv_a\right|.
\]
The component orthogonal to $\mathrm{col}(X_i)$ drops out. By Cauchy--Schwarz,
\[
\left|\mathbf k_i(s)^{\mathrm H}(G_i+\lambda I)^{-1}P_iv_a\right|
\le
\sqrt{\mathbf k_i(s)^{\mathrm H}G_i^\dagger\mathbf k_i(s)}
\sqrt{(P_iv_a)^{\mathrm H}G_i(G_i+\lambda I)^{-2}(P_iv_a)}.
\]
The first factor is at most one by Assumption~\ref{assum:common_rkhs}(iii). On $\mathrm{col}(X_i)$, every positive eigenvalue $t$ of $G_i$ satisfies
$t/(t+\lambda)^2\le1/(\gamma_i+\lambda)$. Hence
\begin{equation}
|Q_i(s,a;\mathcal R_i(Y))-Q_i(s,a;\mathcal R_i(Y'))|
\le\frac{\|P_iv_a\|_2}{\sqrt{\gamma_i+\lambda}}.
\label{eq:ridge_sensitivity}
\end{equation}

\subsection*{Step 3: Bound $B_2$ (oracle-teacher mismatch)}
Apply \eqref{eq:ridge_sensitivity} with
$v_a=\bar Q_a^{\mathrm{ref}}-\hat Q_{i,a}^{\mathrm{ref}}$. Lemma~\ref{lem:term_A} and the reproducing property yield
\[
\|v_a\|_2
\le\sum_{j\ne i}\pi_j
\|\hat Q_{j,a}^{\mathrm{ref}}-\hat Q_{i,a}^{\mathrm{ref}}\|_2
\le\sqrt m\sum_{j\ne i}\pi_jh_{ij}
=\sqrt m\,\bar h_i.
\]
Therefore
\[
B_2\le\frac{\sqrt m}{\sqrt{\gamma_i+\lambda}}\,\bar h_i.
\]

\subsection*{Step 4: Bound $B_3$ (client estimation)}
Now take
\[
E_a\defeq Q_{\mathrm{ref},a}^{\mathrm{glob}}-\bar Q_a^{\mathrm{ref}}
=\sum_j\pi_j\bigl(Q_{j,a}^{\mathrm{ref}}-\hat Q_{j,a}^{\mathrm{ref}}\bigr).
\]
By the definition of $\varepsilon_j^{\mathrm{est}}$,
\[
\|E_a\|_2
\le\sum_j\pi_j\|Q_{j,a}^{\mathrm{ref}}-\hat Q_{j,a}^{\mathrm{ref}}\|_2
\le\sqrt m\,\bar\varepsilon^{\mathrm{est}},
\]
where the sum includes client $i$. Applying \eqref{eq:ridge_sensitivity} gives
\[
B_3\le\frac{\sqrt m}{\sqrt{\gamma_i+\lambda}}\,\bar\varepsilon^{\mathrm{est}}.
\]

Combining these three bounds in \eqref{eq:master_decomp} yields
\[
|\Delta_i(s,a)|
\le
\frac{\sqrt m}{\sqrt{\gamma_i+\lambda}}
\bigl(\bar h_i+\bar\varepsilon^{\mathrm{est}}\bigr)
+
\left(\frac{\lambda}{\gamma_i+\lambda}+\rho_i(s)\right)\|\hat W_i\|_F,
\]
which is \eqref{eq:fed_gap_bound}.
\qed


